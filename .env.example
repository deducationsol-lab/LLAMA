# Public Meta Muse configuration — safe to commit.
MUSE_API_DOCS_URL=https://dev.meta.ai/docs/
MUSE_MODELS_URL=https://dev.meta.ai/docs/models
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_CHAT_PATH=/chat/completions
MUSE_MODEL_ID=muse-spark-1.3

# Server-only database configuration. Never use VITE_ prefixes or commit real values.
# Runtime destination: the Neon PostgreSQL database used by Better Auth.
NEON_DATABASE_URL=
# Optional, read-only source used only by the inventory command; never used by the app.
SUPABASE_MIGRATION_DATABASE_URL=

# Secrets — fill only in ignored server/.env or hosting environment settings.
# Never put keys in the browser or commit real values.
MODEL_API_KEY=
# Separate private demo password, 16-256 characters. NOT your Meta API key.
HOUSEHOLD_ACCESS_CODE=

# Family settings: apply migrations/20261107_family_settings.sql after backup.
# Configure per environment; keep the private key and cron secret server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=

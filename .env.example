# Public Meta Muse configuration — safe to commit.
MUSE_API_DOCS_URL=https://dev.meta.ai/docs/
MUSE_MODELS_URL=https://dev.meta.ai/docs/models
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_CHAT_PATH=/chat/completions
MUSE_MODEL_ID=muse-spark-1.3

# Secrets — fill only in ignored server/.env or hosting environment settings.
# Never use VITE_ prefixes, put keys in the browser, or commit real values.
MODEL_API_KEY=
# Separate private demo password, 16-256 characters. NOT your Meta API key.
HOUSEHOLD_ACCESS_CODE=

# Family settings: use the existing Better Auth PostgreSQL database.
# Apply migrations/20261107_family_settings.sql before enabling this feature.
# Web Push values are configured per environment; never commit real keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=

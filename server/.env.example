# Server-only. Copy to .env.local locally; never prefix these with VITE_.
# llama = official Llama API protocol; openai-compatible = /chat/completions protocol.
LLAMA_PROVIDER=llama
LLAMA_API_KEY=
# Use the EXACT model ID supplied by your API provider (no assumed default).
LLAMA_MODEL=
# Optional for llama (SDK default https://api.llama.com/v1).
# Required for openai-compatible; include /v1 if the provider requires it.
LLAMA_BASE_URL=
# A separate private demo password, 16-256 characters. NOT your API key.
LLAMA_ACCESS_CODE=
